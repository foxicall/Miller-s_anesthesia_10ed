{
  "name": "miller-anesthesia-clinical-handbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 0.0.0.0",
    "build": "vitepress build docs && node --import tsx scripts/verify-build.ts",
    "build:complete": "node --import tsx scripts/prepare-content.ts --strict && npm run build",
    "preview": "vitepress preview docs",
    "content:sync": "node --import tsx scripts/prepare-content.ts",
    "icons": "node --import tsx scripts/generate-icons.ts",
    "typecheck": "npm run content:sync && vue-tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vite-pwa/vitepress": "1.1.0",
    "fflate": "^0.8.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "minisearch": "^7.1.2",
    "sharp": "^0.34.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.0"
  }
}
